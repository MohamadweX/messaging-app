* {
  box-sizing: border-box;
}

:root {
  --bg: #0f172a;
  --panel: #ffffff;
  --muted: #64748b;
  --soft: #eef2ff;
  --primary: #22c55e;
  --primary-dark: #15803d;
  --text: #0f172a;
  --incoming: #f1f5f9;
  --outgoing: #dcfce7;
  --border: rgba(148, 163, 184, 0.25);
  --shadow: 0 25px 50px rgba(15, 23, 42, 0.18);
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  min-height: 100vh;
  font-family: 'Inter', sans-serif;
  background: linear-gradient(135deg, #111827 0%, #1f2937 100%);
  color: var(--text);
}

button, input {
  font: inherit;
}

button {
  cursor: pointer;
}

.auth-shell {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 32px;
}

.auth-card {
  width: min(100%, 440px);
  background: rgba(255, 255, 255, 0.12);
  border: 1px solid rgba(255, 255, 255, 0.18);
  box-shadow: var(--shadow);
  backdrop-filter: blur(18px);
  border-radius: 28px;
  padding: 32px 28px;
  color: white;
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 24px;
}

.brand-icon {
  width: 56px;
  height: 56px;
  border-radius: 18px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, var(--primary), #4ade80);
  color: white;
  font-size: 1.8rem;
  font-weight: 800;
}

.eyebrow {
  margin: 0 0 4px;
  opacity: 0.75;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-size: 0.7rem;
}

h1 {
  margin: 0;
  font-size: 2rem;
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.auth-form label {
  display: flex;
  flex-direction: column;
  gap: 10px;
  font-weight: 600;
}

.auth-form input {
  width: 100%;
  height: 52px;
  border-radius: 14px;
  border: 1px solid rgba(255, 255, 255, 0.15);
  background: rgba(255, 255, 255, 0.08);
  outline: none;
  padding: 0 16px;
  font-size: 1rem;
  color: white;
}

.auth-form input::placeholder {
  color: rgba(255, 255, 255, 0.55);
}

.primary-btn {
  margin-top: 8px;
  width: 100%;
  height: 52px;
  border: 0;
  border-radius: 14px;
  background: linear-gradient(135deg, var(--primary), #4ade80);
  color: white;
  font-weight: 700;
  font-size: 1rem;
  box-shadow: 0 10px 24px rgba(34, 197, 94, 0.35);
}

.app-shell {
  max-width: 1280px;
  height: 100vh;
  margin: 0 auto;
  display: flex;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(10px);
  box-shadow: var(--shadow);
}

.sidebar {
  width: 360px;
  background: #f8fafc;
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
}

.sidebar-header {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 24px 18px 18px;
  border-bottom: 1px solid var(--border);
}

.avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-weight: 700;
  background: linear-gradient(135deg, #a7f3d0, #22c55e);
  color: #14532d;
}

.profile-avatar {
  width: 56px;
  height: 56px;
}

.avatar.small {
  width: 42px;
  height: 42px;
  font-size: 0.8rem;
}

.avatar.green {
  background: linear-gradient(135deg, #bbf7d0, #4ade80);
}

.sidebar-header h2 {
  margin: 0;
  font-size: 1.05rem;
}

.sidebar-header span {
  color: var(--muted);
  font-size: 0.8rem;
}

.search-box {
  margin: 16px 18px;
  background: white;
  border: 1px solid var(--border);
  border-radius: 14px;
  height: 46px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 12px;
}

.search-box input {
  border: 0;
  outline: none;
  flex: 1;
  background: transparent;
  color: var(--text);
}

.chat-list {
  flex: 1;
  overflow-y: auto;
  padding: 0 12px 18px;
}

.chat-item {
  width: 100%;
  background: transparent;
  border: 0;
  border-radius: 16px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 10px;
  text-align: left;
  transition: 0.2s ease;
}

.chat-item:hover,
.chat-item.active {
  background: #e2e8f0;
}

.chat-meta {
  flex: 1;
  min-width: 0;
}

.chat-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.chat-row strong {
  font-size: 0.96rem;
}

.chat-row span,
.chat-row small {
  color: var(--muted);
}

.chat-row small {
  display: block;
  max-width: 180px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.badge {
  min-width: 22px;
  height: 22px;
  border-radius: 999px;
  background: var(--primary);
  color: white;
  display: grid;
  place-items: center;
  font-size: 0.72rem;
  font-weight: 700;
}

.chat-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 22px;
  border-bottom: 1px solid var(--border);
  background: white;
}

.header-user {
  display: flex;
  align-items: center;
  gap: 12px;
}

.header-user h3 {
  margin: 0;
  font-size: 1.1rem;
}

.header-user span,
.header-actions button {
  color: var(--muted);
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.header-actions button,
.icon-btn {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  border: 0;
  background: #f1f5f9;
  color: var(--text);
}

.messages-area {
  flex: 1;
  background: linear-gradient(180deg, #f8fafc 0%, #edf7f0 100%);
  padding: 20px 20px 12px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.message-bubble {
  max-width: min(70%, 540px);
  padding: 12px 14px 10px;
  border-radius: 18px 18px 18px 8px;
  box-shadow: 0 8px 22px rgba(15, 23, 42, 0.05);
}

.message-bubble p {
  margin: 0 0 8px;
  line-height: 1.5;
}

.message-bubble span {
  display: block;
  text-align: right;
  font-size: 0.7rem;
  opacity: 0.7;
}

.message-bubble.incoming {
  background: var(--incoming);
  align-self: flex-start;
}

.message-bubble.outgoing {
  background: var(--outgoing);
  align-self: flex-end;
  border-radius: 18px 18px 8px 18px;
}

.typing-indicator {
  align-self: flex-start;
  color: var(--muted);
  font-size: 0.82rem;
  background: white;
  border-radius: 12px;
  padding: 8px 12px;
}

.quick-actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  padding: 10px 18px 0;
}

.quick-actions button {
  border: 1px solid var(--border);
  background: white;
  color: var(--text);
  border-radius: 999px;
  padding: 8px 12px;
}

.composer {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 18px 20px 22px;
  background: white;
  border-top: 1px solid var(--border);
}

.composer input {
  flex: 1;
  border: 1px solid var(--border);
  background: #f8fafc;
  border-radius: 999px;
  height: 48px;
  padding: 0 18px;
  outline: none;
}

.send-btn {
  border: 0;
  border-radius: 999px;
  background: linear-gradient(135deg, var(--primary), #4ade80);
  color: white;
  font-weight: 700;
  padding: 10px 18px;
}

@media (max-width: 900px) {
  .app-shell {
    display: block;
    height: auto;
    min-height: 100vh;
  }

  .sidebar {
    width: 100%;
    border-right: 0;
    border-bottom: 1px solid var(--border);
  }

  .chat-panel {
    min-height: 72vh;
  }
}

@media (max-width: 560px) {
  .auth-card {
    padding: 24px 18px;
  }

  .chat-row small {
    display: none;
  }

  .message-bubble {
    max-width: 82%;
  }
}
